{
  "name": "jamal-pos-express",
  "private": true,
  "version": "1.0.0",
  "description": "Jamal Café & Bakery POS System (Pure Node.js & Express)",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:ui": "playwright test tests/ui",
    "lint": "eslint models server.js public/app.js",
    "profile:dynamic": "node scripts/profile_dynamic.js",
    "plato": "es6-plato -r -d ../reports/plato -t \"Jamal POS - Plato Code Analysis & Complexity Report\" models tests server.js public/app.js",
    "test:plato": "npm run test:coverage && npm run plato"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/*.test.js"
    ],
    "collectCoverageFrom": [
      "models/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "es6-plato": "^1.2.3",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  }
}

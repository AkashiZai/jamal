{
  "name": "jamal-pos-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Jamal Café & Bakery POS System Workspace",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "scripts": {
    "build": "npm --prefix frontend ci --omit=dev",
    "start": "node frontend/server.js",
    "dev": "npm --prefix frontend run dev",
    "test": "npm --prefix frontend test",
    "test:coverage": "npm --prefix frontend run test:coverage",
    "test:ui": "npm --prefix frontend run test:ui",
    "plato": "npm --prefix frontend run plato",
    "test:plato": "npm --prefix frontend run test:plato",
    "lint": "npm --prefix frontend run lint",
    "install:all": "npm --prefix frontend install"
  }
}
